# ─── Clerk Authentication ─────────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ─── Database (PostgreSQL on Railway) ────────────────────────────────
DATABASE_URL=postgresql://user:password@host:port/dbname

# ─── AI — Google Gemini (primary, free tier) ─────────────────────────
GEMINI_API_KEY=AIza...

# ─── AI — Groq (fallback, free tier) ─────────────────────────────────
GROQ_API_KEY=gsk_...

# ─── Stripe (add later for payments) ────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Admin ───────────────────────────────────────────────────────────
# Email address that should be auto-promoted to admin on first login
ADMIN_EMAIL=doc@example.com

# ─── Production ──────────────────────────────────────────────────────
# CLIENT_URL=https://synapse.us
# PORT=3001

# ─── Communication Coach (external Comm Module) ───────────────────────
# Public https origin of the Comm Module, no trailing slash. Never hardcode.
# Synapse deep-links: {VITE_COMM_BASE}/?coach=1&outcome=...&returnUrl=...
# Comm Coach is NOT Clerk — no shared session. No PHI in query params.
# TODO(Head Dev): set in Railway / client build env when Comm Module URL is live.
VITE_COMM_BASE=
